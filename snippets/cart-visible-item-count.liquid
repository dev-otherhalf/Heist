{% doc %}
  Cart Visible Item Count

  Total quantity across cart lines, excluding the membership line and any
  gifted line (see `cart-line-card-type`). Use this wherever the cart shows a
  customer-facing count, so a membership or gift never makes the number look
  wrong.

  @example
  {% capture cart_visible_item_count %}
    {% render 'cart-visible-item-count' %}
  {% endcapture %}
  {{ cart_visible_item_count | strip }}
{% enddoc %}

{%- liquid
  assign cart_visible_item_count = 0
  for item in cart.items
    capture item_card_type
      render 'cart-line-card-type', item: item
    endcapture
    assign item_card_type = item_card_type | strip

    if item_card_type == blank
      assign cart_visible_item_count = cart_visible_item_count | plus: item.quantity
    endif
  endfor
-%}
{{- cart_visible_item_count -}}
