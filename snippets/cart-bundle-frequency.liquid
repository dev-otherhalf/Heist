{% doc %}
  Cart Bundle Frequency

  The control shown under a buy-box bundle card (see cart-bundle-card.liquid)
  for switching the whole group's delivery plan at once. Two states,
  mirroring cart-line-selling-plan.liquid but applied to every line in the
  group instead of just one — cart-bundle-card.liquid never calls this
  snippet at all for a third, prepaid state, rendering that one itself (see
  below):

  - Group is one-time (no line holds a plan) → a single "Subscribe & save X%"
    button, but only once the group's combined bag quantity reaches
    `cart_bundle_min_subscription_bags` (default 3) — below that, nothing
    renders at all, same as the PDP buy box only offering a subscription
    once enough bags are selected. Clicking the button applies the
    preferred plan (by name, same `cart_subscribe_target_plan` setting) to
    every line in the group.
  - Group is subscribed to a non-prepaid plan → a dropdown of "One time
    purchase" plus every non-prepaid plan any component offers. One dropdown
    controls every line in the group: each component product has its OWN
    selling-plan id for what is conceptually the same frequency, so options
    are deduped by plan NAME (same approach as
    snippets/buy-box-variation-3.liquid on the product page) and the JS
    resolves each line's own plan id by matching that name. Choosing "One
    time purchase" clears every line in the group back to one-time.

  A prepaid group gets neither: upgrading to a prepaid term only happens on
  the product page, so there's nothing here for a switcher to offer.
  cart-bundle-card.liquid renders the `cart_prepaid_option_label` setting
  ("Ships every 4 weeks") as static text of its own, stacked under the
  "Prepaid for 3 months" badge in the price column — a prepaid group has no
  control to put in this snippet's usual full-width row, so that row is
  skipped for it entirely.

  @param {string} bundle_group - The shared properties._bundle_group value
    that ties this group's cart lines together.
  @param {string} line_numbers - Comma-separated 1-based cart line indexes
    for the group, in cart order.
{% enddoc %}

{% liquid
  # option name (downcased) => JSON-ish map built manually below, since each
  # component's variant carries its own plan id for that name.
  assign seen_plan_names = ''
  assign current_plan_name = ''
  assign has_options = false
  assign group_is_one_time = true
  assign group_quantity = 0

  for group_item in cart.items
    if group_item.properties._bundle_group != bundle_group
      continue
    endif
    if current_plan_name == ''
      assign current_plan_name = group_item.selling_plan_allocation.selling_plan.name | downcase
    endif
    if group_item.selling_plan_allocation != null
      assign group_is_one_time = false
    endif
    assign group_quantity = group_quantity | plus: group_item.quantity
    for allocation in group_item.variant.selling_plan_allocations
      assign plan_name_dc = allocation.selling_plan.name | downcase
      unless plan_name_dc contains 'prepaid' or plan_name_dc contains 'prepay'
        assign has_options = true
      endunless
    endfor
  endfor

  # The "Subscribe & save" CTA only offers upgrading once the bundle has
  # enough bags — same minimum-bags gate the PDP buy box applies before a
  # subscription tier becomes selectable at all (block.settings.min_subscription_bags).
  # Doesn't apply to an already-subscribed group: this only gates the offer
  # to upgrade, not an existing subscription's ability to change frequency.
  assign min_subscription_bags = settings.cart_bundle_min_subscription_bags | default: 3
  assign show_control = has_options
  if group_is_one_time and group_quantity < min_subscription_bags
    assign show_control = false
  endif

  # The plan the "Subscribe & save" CTA applies: the preferred one by name
  # (same setting the single-line CTA uses), else the first non-prepaid plan
  # any component in the group offers. Mirrors cart-line-selling-plan.liquid's
  # own target-plan resolution, but by plan NAME since each component has its
  # own id for it — the JS resolves each line's id from the plan map below.
  assign preferred_plan_key = settings.cart_subscribe_target_plan | downcase | strip
  assign target_plan_name = ''
  assign target_plan_price = 0
  assign target_variant_price = 0
  assign target_is_preferred = false

  for group_item in cart.items
    if group_item.properties._bundle_group != bundle_group
      continue
    endif
    for allocation in group_item.variant.selling_plan_allocations
      assign plan_name_dc = allocation.selling_plan.name | downcase
      unless plan_name_dc contains 'prepaid' or plan_name_dc contains 'prepay'
        assign plan_is_shared = true
        for sibling_item in cart.items
          if sibling_item.properties._bundle_group != bundle_group
            continue
          endif
          assign sibling_has_plan = false
          for sibling_allocation in sibling_item.variant.selling_plan_allocations
            assign sibling_plan_name_dc = sibling_allocation.selling_plan.name | downcase
            if sibling_plan_name_dc == plan_name_dc
              assign sibling_has_plan = true
            endif
          endfor
          unless sibling_has_plan
            assign plan_is_shared = false
          endunless
        endfor

        if plan_is_shared
          unless target_is_preferred
            if target_plan_name == ''
              assign target_plan_name = plan_name_dc
              assign target_plan_price = allocation.per_delivery_price
              assign target_variant_price = group_item.variant.price
            endif
            if preferred_plan_key != blank and plan_name_dc contains preferred_plan_key
              assign target_plan_name = plan_name_dc
              assign target_plan_price = allocation.per_delivery_price
              assign target_variant_price = group_item.variant.price
              assign target_is_preferred = true
            endif
          endunless
        endif
      endunless
    endfor
  endfor

  if target_plan_name == ''
    assign show_control = false
  endif
%}

{%- comment -%}
  cart-bundle-card.liquid never calls this snippet at all for a prepaid
  group — the "ships every" cadence is rendered there instead, stacked under
  the "Prepaid for 3 months" badge in the price column, since a prepaid
  group has no switcher for this full-width row to hold. Reaching this point
  means the group is non-prepaid, so only the CTA/dropdown states remain.

  A one-time group additionally has to meet the minimum-bags gate before the
  CTA is offered at all — below it, nothing renders here, same as the PDP
  buy box only offering a subscription tier once enough bags are selected.
  A group already subscribed skips this gate entirely: it only controls
  whether the offer to UPGRADE appears, not whether an existing
  subscription can still change frequency.
{%- endcomment -%}
{%- if show_control -%}
  {%- assign select_id = 'cart-bundle-plan-' | append: line_numbers | remove: ',' -%}

  <cart-bundle-selling-plan
    class="cart-line-plan cart-bundle-plan"
    data-lines="{{ line_numbers }}"
  >
    {%- comment -%}
      Each line's own plan id per frequency name — Liquid resolves this once
      here since every component product has its own id for what's shown as
      one shared option. The JS looks up [line][chosenName] to know what to
      send /cart/change.js for that specific line.
    {%- endcomment -%}
    <script type="application/json" data-bundle-plan-map>
      {
        {%- assign line_first = true -%}
        {%- for group_item in cart.items -%}
          {%- if group_item.properties._bundle_group != bundle_group -%}
            {%- continue -%}
          {%- endif -%}
          {%- unless line_first -%},{%- endunless -%}
          {%- assign line_first = false -%}
          {%- assign group_line = group_item.index | plus: 1 -%}
          "{{ group_line }}": {
            "line": {{ group_line | json }},
            "key": {{ group_item.key | json }},
            "quantity": {{ group_item.quantity | json }},
            "plans": {
              {%- assign line_seen_names = '' -%}
              {%- for allocation in group_item.variant.selling_plan_allocations -%}
                {%- assign plan_name_dc = allocation.selling_plan.name | downcase -%}
                {%- assign name_key = '[' | append: plan_name_dc | append: ']' -%}
                {%- unless plan_name_dc contains 'prepaid' or plan_name_dc contains 'prepay' or line_seen_names contains name_key -%}
                  {%- unless line_seen_names == '' -%},{%- endunless -%}
                  {%- assign line_seen_names = line_seen_names | append: name_key -%}
                  {{ plan_name_dc | json }}: {{ allocation.selling_plan.id | json }}
                {%- endunless -%}
              {%- endfor -%}
            }
          }
        {%- endfor -%}
      }
    </script>

    {%- if group_is_one_time -%}
      {%- liquid
        assign discount_label = ''
        if target_variant_price > 0 and target_plan_price > 0 and target_plan_price < target_variant_price
          assign discount_label = target_variant_price | minus: target_plan_price | times: 100.0 | divided_by: target_variant_price | round | append: '%'
        endif
        assign cta_label = settings.cart_subscribe_cta_label | default: 'Subscribe & save [discount]'
        assign cta_label = cta_label | replace: '[discount]', discount_label | strip
      -%}
      <button
        type="button"
        class="cart-line-plan__cta cart-bundle-plan__cta t-n1-med"
        data-bundle-selling-plan="{{ target_plan_name | escape }}"
      >
        {{- cta_label -}}
      </button>
    {%- else -%}
      <label class="visually-hidden" for="{{ select_id }}">
        {{ 'Delivery frequency' }}
      </label>

      <select
        id="{{ select_id }}"
        class="cart-line-plan__select cart-bundle-plan__select t-n1"
        data-selected="{{ current_plan_name }}"
      >
        {%- comment -%}
          Dedupe by plan NAME across every component in the group, and only
          show names every component offers. That keeps the shared dropdown
          from creating a mixed bundle state where only some lines can move.
        {%- endcomment -%}
        {%- for group_item in cart.items -%}
          {%- if group_item.properties._bundle_group != bundle_group -%}
            {%- continue -%}
          {%- endif -%}
          {%- for allocation in group_item.variant.selling_plan_allocations -%}
            {%- assign plan = allocation.selling_plan -%}
            {%- assign plan_name_dc = plan.name | downcase -%}
            {%- assign name_key = '[' | append: plan_name_dc | append: ']' -%}
            {%- unless plan_name_dc contains 'prepaid' or plan_name_dc contains 'prepay' -%}
              {%- unless seen_plan_names contains name_key -%}
                {%- liquid
                  assign plan_is_shared = true
                  for sibling_item in cart.items
                    if sibling_item.properties._bundle_group != bundle_group
                      continue
                    endif
                    assign sibling_has_plan = false
                    for sibling_allocation in sibling_item.variant.selling_plan_allocations
                      assign sibling_plan_name_dc = sibling_allocation.selling_plan.name | downcase
                      if sibling_plan_name_dc == plan_name_dc
                        assign sibling_has_plan = true
                      endif
                    endfor
                    unless sibling_has_plan
                      assign plan_is_shared = false
                    endunless
                  endfor
                -%}
                {%- if plan_is_shared -%}
                  {%- assign seen_plan_names = seen_plan_names | append: name_key -%}
                  <option
                    value="{{ plan_name_dc | escape }}"
                    {% if plan_name_dc == current_plan_name %}
                      selected
                    {% endif %}
                  >
                    {{ plan.name }}
                  </option>
                {%- endif -%}
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      </select>

      <span class="cart-line-plan__chevron svg-wrapper" aria-hidden="true">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    {%- endif -%}
  </cart-bundle-selling-plan>

  {% render 'vite-tag' with 'sections/scripts/cart-bundle-selling-plan.js' %}
{%- endif -%}
