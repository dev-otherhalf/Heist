{% comment %}
  Renders Shopify /cart/add.js line-item JSON objects (trailing comma included)
  for the "Join the Heist Society" button. If `product` has
  buy_box_stitched_products, only those bundled metafield products are added;
  the selected parent product is used as the bundle source, not as a cart line.
  If no stitched products exist, the resolved variant is added as a normal
  fallback line.

  @param {variant} variant - resolved fallback line variant
  @param {number} variant_id - raw numeric variant id, used only when `variant`
    couldn't be resolved (e.g. a merchant-typed variant ID that doesn't match
    any variant on `product`, matching the old literal-ID behavior) — no
    selling-plan lookup is possible for this fallback, so the line goes in
    one-time.
  @param {product} product - read for stitched add-ons
  @param {string} bundle_group - shared _bundle_group property value
  @param {string} bundle_title - shared _bundle_title property value

  When `product` HAS stitched add-ons (buy_box_stitched_products metafield),
  every stitched variant is auto-upgraded onto its own first "prepaid" selling
  plan (matched by name, same hint buy-box.js uses) and tagged into one bundle
  group so the cart drawer renders the whole click as a single bundle card (see
  cart-bundle-card.liquid).

  When `product` has NO stitched add-ons, the kit variant goes in as a plain
  line — no selling_plan, no bundle properties — same as adding that product
  normally anywhere else on the site.
{% endcomment %}

{%- liquid
  assign stitched_products = product.metafields.custom.buy_box_stitched_products.value
  assign has_stitched = false
  if stitched_products != blank and stitched_products.size > 0
    assign has_stitched = true
  endif

  if variant != blank and has_stitched == false
    echo '{"id":' | append: variant.id | append: ',"quantity":1},'
  elsif variant_id != blank and has_stitched == false
    echo '{"id":' | append: variant_id | append: ',"quantity":1},'
  endif

  for stitched_product in stitched_products
    assign stitched_variant = stitched_product.selected_or_first_available_variant | default: stitched_product.first_available_variant
    if stitched_variant == blank
      continue
    endif

    assign stitched_plan_id = ''
    for alloc in stitched_variant.selling_plan_allocations
      if alloc.selling_plan.name contains 'prepaid' or alloc.selling_plan.name contains 'Prepaid'
        assign stitched_plan_id = alloc.selling_plan.id
        break
      endif
    endfor

    echo '{"id":' | append: stitched_variant.id | append: ',"quantity":1'
    if stitched_plan_id != blank
      echo ',"selling_plan":' | append: stitched_plan_id
    endif
    echo ',"properties":{"_bundle_group":"' | append: bundle_group | append: '","_bundle_title":"' | append: bundle_title | append: '"}},'
  endfor
-%}
