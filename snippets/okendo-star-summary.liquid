{% comment %}
  Okendo rating summary — five stars filled to the average rating (full / half /
  empty), followed by "(N reviews)". Reads Okendo's `summaryData` metafield,
  which looks like {"reviewCount"=>888, "reviewAverageValue"=>"5.0"}. Renders
  nothing when the product has no reviews.

  @param {product} product - The product whose reviews to summarize.
{% endcomment %}

{%- liquid
  assign summary = product.metafields.okendo.summaryData.value | default: product.metafields.okendo.summaryData
  assign review_count = summary.reviewCount | default: 0
  assign rating = summary.reviewAverageValue | default: 0.0 | times: 1.0
  assign rating_halves = rating | times: 2 | round

  assign review_word = 'reviews'
  if review_count == 1
    assign review_word = 'review'
  endif
-%}

{%- if review_count > 0 -%}
  <div
    class="star-summary"
    aria-label="{{ rating }} out of 5 stars ({{ review_count }} {{ review_word }})"
  >
    <span class="star-summary__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        {%- liquid
          assign full_at = i | times: 2
          assign half_at = full_at | minus: 1
          assign star_type = 'empty'
          if full_at <= rating_halves
            assign star_type = 'full'
          elsif half_at == rating_halves
            assign star_type = 'half'
          endif
        -%}
        {%- if star_type == 'full' -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 13 13" fill="none">
            <path d="M6.1416 10.1419C6.28064 10.0579 6.45471 10.0579 6.59375 10.1419L9.80599 12.0806C10.1373 12.2806 10.546 11.9836 10.4581 11.6067L9.60567 7.95257C9.56877 7.79442 9.62252 7.62884 9.74527 7.5225L12.5839 5.06336C12.8765 4.80995 12.7201 4.32946 12.3345 4.29675L8.59755 3.97971C8.43586 3.96599 8.29505 3.86391 8.23172 3.7145L6.77049 0.266818C6.61973 -0.088882 6.11562 -0.0888818 5.96486 0.266818L4.50363 3.7145C4.4403 3.86391 4.29949 3.96599 4.1378 3.97971L0.400888 4.29675C0.0152645 4.32946 -0.141101 4.80995 0.151411 5.06336L2.99009 7.5225C3.11283 7.62884 3.16658 7.79442 3.12968 7.95257L2.27723 11.6067C2.18931 11.9836 2.59804 12.2806 2.92936 12.0806L6.1416 10.1419Z" fill="#161414"/>
          </svg>
        {%- elsif star_type == 'half' -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 13 13" fill="none">
            <defs>
              <linearGradient id="halfStar" x1="0" y1="0" x2="13" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="50%" stop-color="#161414"/>
                <stop offset="50%" stop-color="white"/>
                <stop offset="100%" stop-color="white"/>
              </linearGradient>
            </defs>

            <path
              d="M6.1416 10.1419C6.28064 10.0579 6.45471 10.0579 6.59375 10.1419L9.80599 12.0806C10.1373 12.2806 10.546 11.9836 10.4581 11.6067L9.60567 7.95257C9.56877 7.79442 9.62252 7.62884 9.74527 7.5225L12.5839 5.06336C12.8765 4.80995 12.7201 4.32946 12.3345 4.29675L8.59755 3.97971C8.43586 3.96599 8.29505 3.86391 8.23172 3.7145L6.77049 0.266818C6.61973 -0.088882 6.11562 -0.0888818 5.96486 0.266818L4.50363 3.7145C4.4403 3.86391 4.29949 3.96599 4.1378 3.97971L0.400888 4.29675C0.0152645 4.32946 -0.141101 4.80995 0.151411 5.06336L2.99009 7.5225C3.11283 7.62884 3.16658 7.79442 3.12968 7.95257L2.27723 11.6067C2.18931 11.9836 2.59804 12.2806 2.92936 12.0806L6.1416 10.1419Z"
              fill="url(#halfStar)"
              stroke="#161414"
              stroke-width="0.5"
            />
          </svg>
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 13 13" fill="none">
            <path
              d="M6.1416 10.1419C6.28064 10.0579 6.45471 10.0579 6.59375 10.1419L9.80599 12.0806C10.1373 12.2806 10.546 11.9836 10.4581 11.6067L9.60567 7.95257C9.56877 7.79442 9.62252 7.62884 9.74527 7.5225L12.5839 5.06336C12.8765 4.80995 12.7201 4.32946 12.3345 4.29675L8.59755 3.97971C8.43586 3.96599 8.29505 3.86391 8.23172 3.7145L6.77049 0.266818C6.61973 -0.088882 6.11562 -0.0888818 5.96486 0.266818L4.50363 3.7145C4.4403 3.86391 4.29949 3.96599 4.1378 3.97971L0.400888 4.29675C0.0152645 4.32946 -0.141101 4.80995 0.151411 5.06336L2.99009 7.5225C3.11283 7.62884 3.16658 7.79442 3.12968 7.95257L2.27723 11.6067C2.18931 11.9836 2.59804 12.2806 2.92936 12.0806L6.1416 10.1419Z"
              fill="none"
              stroke="#161414"
              stroke-width="0.8"
            />
          </svg>
        {%- endif -%}
      {%- endfor -%}
    </span>

    <span class="star-summary__count t-n2">(<u>{{ review_count }} {{ review_word }}</u>)</span>
  </div>
{%- endif -%}
