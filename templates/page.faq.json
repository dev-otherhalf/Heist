          "type": "question",
          "settings": {
            "question": "How should I store it?",
            "answer": "<p>Sealed, with the air pressed out of the container, at room temperature or cooler, and away from light. The tin we send Heist Society members is built for exactly this.</p>",
            "anchor": "how-should-i-store-it",
            "open_by_default": false
          }
        },
