        "question_27": {
          "type": "question",
          "settings": {
            "question": "How does the subscription work?",
            "answer": "<p>Pick your coffees and subscribe. We start you off on 30 day shipments. Once you're signed up you can change the cadence, skip, pause, swap, or cancel any time from your account. No email required.</p>",
            "anchor": "how-does-the-subscription-work",
