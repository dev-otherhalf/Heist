{%- render 'vite-tag', entry: 'sections/styles/not-found-banner.scss' -%}

{%- liquid
  assign fallback_alt = 'Drink Heist'

  assign background_image = section.settings.background_image | default: section.settings.background_image_mobile
  assign background_alt = background_image.alt | default: fallback_alt

  assign cup_image_desktop = section.settings.cup_image | default: section.settings.cup_image_mobile
  assign cup_image_mobile = section.settings.cup_image_mobile | default: section.settings.cup_image
  assign cup_alt = cup_image_desktop.alt | default: cup_image_mobile.alt | default: fallback_alt

  assign cta_words = section.settings.cta_label | split: ' '
  assign cta_half = cta_words.size | divided_by: 2
-%}

{%- capture cta_first_half -%}
  {%- for word in cta_words limit: cta_half -%}
    {{ word }}{% unless forloop.last %} {% endunless %}
  {%- endfor -%}
{%- endcapture -%}

{%- capture cta_second_half -%}
  {%- for word in cta_words offset: cta_half -%}
    {{ word }}{% unless forloop.last %} {% endunless %}
  {%- endfor -%}
{%- endcapture -%}

<div class="not-found-banner">
  {%- if background_image != blank -%}
    <div class="not-found-banner__background">
      <picture>
        {%- if section.settings.background_image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.background_image_mobile | image_url: width: 1500 }}"
          >
        {%- endif -%}
        {{
          background_image
          | image_url: width: 2560
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2560',
            loading: 'eager',
            fetchpriority: 'high',
            alt: background_alt,
            class: 'not-found-banner__background-image'
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="not-found-banner__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="not-found-banner__eyebrow t-h1">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="not-found-banner__heading t-h4">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="not-found-banner__description t-t4">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a
        href="{{ section.settings.cta_link | default: routes.root_url }}"
        class="btn btn--cream btn--split not-found-banner__button"
      >
        <span class="btn__text">{{ cta_first_half | strip }}</span>
        {%- if cta_second_half != blank -%}
          <span class="btn__lines" aria-hidden="true"></span>
          <span class="btn__text">{{ cta_second_half | strip }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  {%- if cup_image_desktop != blank or cup_image_mobile != blank -%}
    <div class="not-found-banner__cup">
      {%- if cup_image_desktop != blank -%}
        <div class="not-found-banner__cup-media not-found-banner__cup-media--desktop">
          {{
            cup_image_desktop
            | image_url: width: 1200
            | image_tag:
              widths: '700, 900, 1200',
              loading: 'lazy',
              alt: cup_alt,
              class: 'not-found-banner__cup-image'
          }}
        </div>
      {%- endif -%}

      {%- if cup_image_mobile != blank -%}
        <div class="not-found-banner__cup-media not-found-banner__cup-media--mobile">
          {{
            cup_image_mobile
            | image_url: width: 700
            | image_tag:
              widths: '400, 700',
              loading: 'lazy',
              alt: cup_alt,
              class: 'not-found-banner__cup-image'
          }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Not found banner",
  "tag": "section",
  "class": "not-found-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nothing to see here."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Looks like this page has gone missing. Let's get you back to somewhere better."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Return to home"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Falls back to your store's home page."
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Falls back to the desktop image."
    },
    {
      "type": "header",
      "content": "Cup image"
    },
    {
      "type": "image_picker",
      "id": "cup_image",
      "label": "Cup image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "cup_image_mobile",
      "label": "Cup image (mobile)",
      "info": "Falls back to the desktop image."
    }
  ],
  "presets": [
    {
      "name": "Not found banner",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
