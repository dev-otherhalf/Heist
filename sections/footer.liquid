                        <g clip-path="url(#clip0_5646_5178)">
                          <path d="M20.0625 22.6875V1.6875" stroke="#161414" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="square"/>
                          <path d="M3.5625 2.4375V21.9375L17.0625 12.1875L3.5625 2.4375Z" fill="#161414" stroke="#161414" stroke-width="1.125" stroke-miterlimit="10" stroke-linecap="square"/>
                        </g>
                        <defs>
                          <clipPath id="clip0_5646_5178">
                            <rect width="24" height="24" fill="white" transform="matrix(-1 0 0 1 24 0)"/>
                          </clipPath>
                        </defs>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="footer__audio-player-control "
                      data-heist-action="loop"
                      aria-label="Loop current track"
                      aria-pressed="false"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M2.0625 8.8125L2.0625 4.3125C2.0625 3.06983 3.06983 2.0625 4.3125 2.0625L19.3125 2.0625C20.5551 2.0625 21.5625 3.06983 21.5625 4.3125L21.5625 14.8125C21.5625 16.0552 20.5551 17.0625 19.3125 17.0625L2.0625 17.0625L2.4375 17.0625" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="square"/>
                        <path d="M7.3125 11.8125L2.0625 17.0625L7.3125 22.3125" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="square"/>
                      </svg>
                    </button>
                </div>
              </div>

              {%- if teddy_icon_image != blank -%}
                <div class="footer__audio-teddy">
                  {% render 'responsive-image',
                    desktop_image: teddy_icon_image,
                    mobile_image: teddy_icon_image,
                    alt: 'Teddy',
                    class: 'footer__teddy-image',
                    sizes: '(max-width: 749px) 100vw, 100vw'
                  %}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- if copyright_text != blank or policy_menu != blank or site_credit != blank -%}
    <div class="footer__strip">
      <div class="page-width">
        <div class="footer__strip-inner">
          {%- if copyright_text != blank -%}
            <div class="footer__copyright t-n3">
              {{- copyright_text -}}
            </div>
          {%- endif -%}
          {%- if policy_menu != blank or site_credit != blank -%}
            <div class="footer__policy-menu">
              {%- for link in policy_menu.links -%}
                <a class="footer__policy-link t-n3" href="{{- link.url -}}">
                  {{- link.title -}}
                </a>
              {%- endfor -%}
              {%- if site_credit != blank -%}
                <div class="footer__policy-credit t-n3">
                  {{- site_credit -}}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.footer",
  "class": "footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Select background color",
      "default": "#FF3B27"
    },
    {
      "type": "color",
      "id": "information_color",
      "label": "Select information color",
      "default": "#161414"
    },
    {
      "type": "header",
      "content": "Layout settings"
    },
    {
      "type": "number",
      "id": "desktop_top_padding",
      "label": "Top padding - Desktop",
      "default": 96
    },
    {
      "type": "number",
      "id": "desktop_bottom_padding",
      "label": "Bottom padding - Desktop",
      "default": 55
    },
    {
      "type": "number",
      "id": "mobile_top_padding",
      "label": "Top padding - Mobile",
      "default": 40
    },
    {
      "type": "number",
      "id": "mobile_bottom_padding",
      "label": "Bottom padding - Mobile",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content settings"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Add footer logo"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Select footer menu"
    },
    {
      "type": "header",
      "content": "Newsletter block settings"
    },
    {
      "type": "color",
      "id": "newsletter_bg_color",
      "label": "Select background color",
      "default": "#DDD6C7"
    },
    {
      "type": "color",
      "id": "newsletter_text_color",
      "label": "Select text color",
      "default": "#161414"
    },
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Add heading text",
      "default": "Join the Heist."
