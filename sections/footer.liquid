{%- render 'vite-tag', entry: 'sections/styles/footer.scss' -%}

{%- liquid
  assign background_color = section.settings.background_color
  assign information_color = section.settings.information_color
  assign desktop_top_padding = section.settings.desktop_top_padding
  assign desktop_bottom_padding = section.settings.desktop_bottom_padding
  assign mobile_top_padding = section.settings.mobile_top_padding
  assign mobile_bottom_padding = section.settings.mobile_bottom_padding

  if section.settings.footer_logo != blank
    assign footer_logo = section.settings.footer_logo
  else
    assign footer_logo = settings.logo
  endif
  assign footer_menu = section.settings.footer_menu

  assign newsletter_bg_color = section.settings.newsletter_bg_color
  assign newsletter_text_color = section.settings.newsletter_text_color
  assign heading_text = section.settings.heading_text
  assign barcode_image = section.settings.barcode_image
  assign barcode_image_mobile = section.settings.barcode_image_mobile
  assign klaviyo_public_key = section.settings.klaviyo_public_key | strip
  assign klaviyo_list_id = section.settings.klaviyo_list_id | strip

  assign audio_bg_color = section.settings.audio_bg_color
  assign audio_text_color = section.settings.audio_text_color
  assign teddy_icon_image = section.settings.teddy_icon_image
  assign audio_blocks = section.blocks | where: 'type', 'audio'
  assign social_blocks = section.blocks | where: 'type', 'social-link'
  assign first_audio_block = audio_blocks.first

  assign radio_station_id = section.settings.radio_station_id | strip
  assign radio_stream_url = section.settings.radio_stream_url | strip
  assign radio_metadata_url = ''

  if radio_station_id != blank
    assign radio_metadata_url = 'https://api.live365.com/station/' | append: radio_station_id
    if radio_stream_url != blank
      assign radio_stream_url_end = radio_stream_url | slice: -1
      unless radio_stream_url_end == '/'
        assign radio_stream_url = radio_stream_url | append: '/'
      endunless
      assign radio_stream_url = radio_stream_url | append: radio_station_id
    endif
  endif

  assign radio_default_title = first_audio_block.settings.audio_title | default: 'HEIST.MUSIC'
  assign radio_default_detail = first_audio_block.settings.audio_detail_text | strip_html | strip
  assign radio_cover_desktop = first_audio_block.settings.audio_poster_image
  assign radio_cover_mobile = first_audio_block.settings.audio_mobile_poster_image
  assign radio_cover_desktop = radio_cover_desktop | default: radio_cover_mobile
  assign radio_cover_mobile = radio_cover_mobile | default: radio_cover_desktop
  assign radio_cover_link = first_audio_block.settings.audio_cover_link | default: 'https://heist.music'

  assign strip_bg_color = section.settings.strip_bg_color
  assign strip_text_color = section.settings.strip_text_color
  assign copyright_text = section.settings.copyright_text
  assign policy_menu = section.settings.policy_menu
  assign site_credit = section.settings.site_credit
-%}

{%- if radio_stream_url != blank or klaviyo_public_key != blank -%}
  {%- render 'vite-tag', entry: 'sections/scripts/footer.js' -%}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {%- if background_color != blank -%}
      --background-color: {{ background_color }};
    {%- endif -%}
    {%- if information_color != blank -%}
      --information-color: {{ information_color }};
    {%- endif -%}

    {%- if desktop_top_padding != blank -%}
      --desktop-top-padding: {{ desktop_top_padding }}px;
    {%- endif -%}
    {%- if desktop_bottom_padding != blank -%}
      --desktop-bottom-padding: {{ desktop_bottom_padding }}px;
    {%- endif -%}
    {%- if mobile_top_padding != blank -%}
      --mobile-top-padding: {{ mobile_top_padding }}px;
    {%- endif -%}
    {%- if mobile_bottom_padding != blank -%}
      --mobile-bottom-padding: {{ mobile_bottom_padding }}px;
    {%- endif -%}

    {%- if newsletter_bg_color != blank -%}
      --newsletter-bg-color: {{ newsletter_bg_color }};
    {%- endif -%}
    {%- if newsletter_text_color != blank -%}
      --newsletter-text-color: {{ newsletter_text_color }};
    {%- endif -%}

    {%- if audio_bg_color != blank -%}
      --audio-bg-color: {{ audio_bg_color }};
    {%- endif -%}
    {%- if audio_text_color != blank -%}
      --audio-text-color: {{ audio_text_color }};
    {%- endif -%}
    {%- if strip_bg_color != blank -%}
      --strip-bg-color: {{ strip_bg_color }};
    {%- endif -%}
    {%- if strip_text_color != blank -%}
      --strip-text-color: {{ strip_text_color }};
    {%- endif -%}
  }
{%- endstyle -%}

<div class="footer" data-footer-root>
  <div class="footer__main">
    <div class="page-width">
      <div class="footer__inner">
        <div class="footer__logo">
          <a class="footer__logo-link" href="{{- shop.url -}}">
            {% render 'responsive-image',
              desktop_image: footer_logo,
              mobile_image: footer_logo,
              alt: 'footer logo',
              class: 'footer__logo-image',
              sizes: '(max-width: 749px) 100vw, 100vw'
            %}
          </a>
        </div>
        {%- if footer_menu != blank -%}
          <ul class="footer__menu">
            {%- for link in footer_menu.links -%}
              <li class="footer__menu-item">
                <a class="footer__menu-link t-nav1" href="{{- link.url -}}">
                  {{- link.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="footer__blocks">
          <div class="footer__newsletter">
            {%- if heading_text != blank or social_blocks.size > 0 -%}
              <div class="footer__newsletter-header">
                {%- if heading_text != blank -%}
                  <div class="footer__newsletter-heading">
                    <h2 class="t-h6">
                      {{- heading_text -}}
                    </h2>
                  </div>
                {%- endif -%}
                {%- if social_blocks.size > 0 -%}
                  <div class="footer__socials">
                    {%- for block in social_blocks -%}
                      {%- if block.settings.social_icon != blank and block.settings.social_link != blank -%}
                        <a class="footer__social-link" href="{{- block.settings.social_link -}}" target="_blank">
                          {% render 'responsive-image',
                            desktop_image: block.settings.social_icon,
                            mobile_image: block.settings.social_icon,
                            alt: 'social icon',
                            class: 'footer__social-icon',
                            sizes: '(max-width: 749px) 100vw, 100vw'
                          %}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if klaviyo_public_key != blank and klaviyo_list_id != blank -%}
              <div class="footer__newsletter-klaviyo" data-klaviyo-newsletter>
                <form
                  class="footer__newsletter-form"
                  data-klaviyo-form
                  data-public-key="{{ klaviyo_public_key | escape }}"
                  data-list-id="{{ klaviyo_list_id | escape }}"
                  data-success-message="{{ section.settings.klaviyo_success_message | default: 'Thanks for joining the Heist.' | escape }}"
                  data-error-message="{{ section.settings.klaviyo_error_message | default: 'Something went wrong. Please try again.' | escape }}"
                  novalidate
                >
                  <label class="visually-hidden" for="FooterEmail-{{ section.id }}">
                    {{- section.settings.klaviyo_placeholder | default: 'Email address' | escape -}}
                  </label>
                  <div class="footer__newsletter-field">
                    <input
                      id="FooterEmail-{{ section.id }}"
                      class="footer__newsletter-input t-n3"
                      data-klaviyo-input
                      type="email"
                      name="email"
                      autocomplete="email"
                      autocorrect="off"
                      autocapitalize="off"
                      placeholder="{{ section.settings.klaviyo_placeholder | default: 'Email address' | escape }}"
                      required
                    >
                    <button
                      class="footer__newsletter-submit"
                      type="submit"
                      data-klaviyo-submit
                      aria-label="{{ 'actions.sign_up' | t }}"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M1 8H13" stroke="#282828" stroke-width="2" stroke-linecap="square"/>
                        <path d="M9 3L14 8L9 13" stroke="#282828" stroke-width="2" stroke-linecap="square"/>
                      </svg>
                    </button>
                  </div>
                </form>
                <p class="footer__newsletter-message t-n3" data-klaviyo-message role="status" hidden></p>
              </div>
            {%- endif -%}
            {% comment %}
              <div class="footer__newsletter-form">
                {%- form 'customer', class: 'email-signup__form' %}
                  <div class="email-signup__input-group email-signup__input-group--arrow">
                    <label
                      for="EmailInput-{{ section.id }}"
                      class="visually-hidden"
                    >
                      {{ 'blocks.email_signup.label' | t }}
                    </label>
                    <input
                      id="EmailInput-{{ section.id }}"
                      class="email-signup__input"
                      type="email"
                      name="contact[email]"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
                      required
                      {% if form.errors and form.id == blank %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="Email-signup__message-error-{{ section.id }}"
                      {% elsif form.posted_successfully? and form.id == blank %}
                        aria-describedby="Email-signup__message-success-{{ section.id }}"
                      {% endif %}
                    >
                    <button
                      class="email-signup__button"
                      aria-label="{{ 'actions.sign_up' | t }}"
                    >
                      <svg
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                        focusable="false"
                        aria-hidden="true"
                        class="email-signup__button-icon"
                      ></svg>
                    </button>
                  </div>

                  {%- if form.errors and form.id == blank -%}
                    <div
                      id="Email-signup__message-error-{{ section.id }}"
                      class="email-signup__message"
                      tabindex="-1"
                    >
                      <svg
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                        focusable="false"
                        aria-hidden="true"
                        class="icon-error"
                      >
                        {%- render 'icon', icon: 'error'  -%}
                      </svg>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </div>
                  {%- endif -%}

                  {%- if form.posted_successfully? and form.id == blank -%}
                    <div
                      id="Email-signup__message-success-{{ section.id }}"
                      class="email-signup__message"
                      tabindex="-1"
                    >
                      <span class="svg-wrapper icon-success">
                        {{ 'icon-checkmark.svg' | inline_asset_content }}
                      </span>
                      <p class="email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
                    </div>
                  {%- endif -%}
                {% endform %}
              </div>
            {% endcomment %}
            {%- if barcode_image != blank -%}
              <div class="footer__newsletter-barcode">
                {% render 'responsive-image',
                  desktop_image: barcode_image,
                  mobile_image: barcode_image_mobile,
                  alt: 'barcode',
                  class: 'footer__barcode-image',
                  sizes: '(max-width: 749px) 100vw, 100vw'
                %}
              </div>
            {%- endif -%}
          </div>
          {%- if radio_stream_url != blank -%}
            <div class="footer__audio">
              <div
                class="footer__audio-player-card"
                data-audio-player
                data-stream-url="{{ radio_stream_url | escape }}"
                data-metadata-url="{{ radio_metadata_url | escape }}"
              >
                <audio data-audio-element preload="none"></audio>

                <div class="footer__audio-player-media">
                  <div class="footer__audio-player-cover-wrap">
                    {%- if radio_cover_desktop != blank -%}
                      <a
                        href="{{ radio_cover_link }}"
                        class="footer__audio-player-cover footer__audio-player-cover--visible"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {% render 'responsive-image',
                          desktop_image: radio_cover_desktop,
                          mobile_image: radio_cover_mobile,
                          alt: radio_default_title,
                          class: 'footer__audio-player-cover-picture',
                          image_class: 'footer__audio-player-cover-image',
                          sizes: '(max-width: 749px) 58px, 76px'
                        %}
                      </a>
                    {%- endif -%}
                    <img
                      class="footer__audio-player-cover-art"
                      data-audio-art
                      alt=""
                      loading="lazy"
                      hidden
                    >
                    <div
                      class="footer__audio-player-cover-placeholder{% if radio_cover_desktop != blank %} footer__audio-player-cover-placeholder--hidden{% endif %}"
                      data-audio-placeholder
                    >
                      FM
                    </div>
                  </div>

                  <div class="footer__audio-player-content">
                    <div class="footer__audio-player-top">
                      <div class="footer__audio-player-header">
                        <p class="footer__audio-player-title t-h6">
                          <a href="{{ radio_cover_link }}" target="_blank" rel="noopener noreferrer">
                            {{- radio_default_title | escape -}}
                          </a>
                        </p>
                        <p class="footer__audio-player-subtitle t-t4">
                          {{- radio_default_detail | escape -}}
                        </p>
                      </div>

                    </div>
                  </div>
                </div>
                <div class="footer__audio-player-progress">
                  <input
                    class="footer__audio-player-range"
                    data-audio-progress
                    type="range"
                    min="0"
                    max="100"
                    value="90"
                    step="0.1"
                    aria-label="Audio progress"
                  >
                </div>
                <div class="footer__audio-player-controls">
                  <button
                    type="button"
                    class="footer__audio-player-control "
                    data-heist-action="shuffle"
                    aria-label="Shuffle"
                    aria-pressed="false"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <g clip-path="url(#clip0_5646_5164)">
                        <path d="M18.8438 2.71875L22.5937 6.46875L18.8438 10.2187" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="square"/>
