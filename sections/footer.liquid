                      </g>
                      <defs>
                        <clipPath id="clip0_5646_5164">
                          <rect width="24" height="24" fill="white"/>
                        </clipPath>
                      </defs>
                    </svg>
                  </button>
                  <button type="button" class="footer__audio-player-control " data-heist-action="previous" aria-label="Previous track">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <g clip-path="url(#clip0_5646_5171)">
                        <path d="M3.9375 22.6875V1.6875" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="square"/>
